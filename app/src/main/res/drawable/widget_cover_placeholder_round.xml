<?xml version="1.0" encoding="utf-8"?>
<!--
    The cover before the first is drawn - in the widget picker's preview: a pane over the gradient with Sona's mark.
    Sized, so a cover view keeps its square place for it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="48dp"
        android:height="48dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_preview_cover" />
        </shape>
    </item>
    <item
        android:width="20dp"
        android:height="20dp"
        android:drawable="@drawable/ic_stat_sona"
        android:gravity="center" />
</layer-list>
