<?xml version="1.0" encoding="utf-8"?>
<!--
    The mini player's card, a pill - its ends half its height round: the brand's gradient, as the widget picker previews it. The widget tints it with the playing cover's
    colour as it draws it, all of it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="1000dp" />
    <gradient
        android:angle="270"
        android:endColor="@color/brand_gradient_end"
        android:startColor="@color/brand_gradient_start" />
</shape>
