<resources>
    <!-- Before Android 12 there is no launch screen: the window shows its background until the
        first frame. -->
    <style name="Theme.Sona.V31" parent="Theme.Material3.DayNight.NoActionBar" />

    <!--
        The window is painted with `surface`, the same colour the app's Compose theme paints behind
        every screen, so nothing of another colour shows before or between frames.
    -->
    <style name="Theme.Sona" parent="Theme.Sona.V31">
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>
</resources>
