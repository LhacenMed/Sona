<?xml version="1.0" encoding="utf-8"?>
<!--
    The "Mini player" widget, one row tall, as the system's own music widget draws it: a pill, the cover a circle at
    its start, and beside it the title alone - no artist - over shuffle, previous, play, next and repeat. Drawn by
    PlaybackWidgets as the "Now Playing" widget is, from the views the two share. What is given here is a preview's -
    the brand's gradient, white placeholders - all of it replaced as the widget is drawn.

    Everything lines up on the column's edges: the title, shuffle's glyph at its start and repeat's at its
    end, the other controls spread evenly between. The cover is inset from the pill's end as from its top and bottom,
    so its circle sits in the pill's round end. The controls take the height left under the text, each at most 28dp
    - play 32dp - and smaller in a short row, rather than cut.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_pill_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_cover_placeholder_round" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/widget_preview_content"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Shuffle, previous, play, next and repeat, reading left to right in every language as the player's own do. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_shuffle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:maxWidth="28dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/shuffle"
                    android:tint="@color/widget_preview_content" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_previous"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_previous"
                    android:maxWidth="28dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/skip_previous"
                    android:tint="@color/widget_preview_content" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/widget_play_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:id="@+id/widget_play_pause_glyph"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no"
                        android:maxWidth="32dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/play"
                        android:tint="@color/widget_preview_content" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_next"
                    android:maxWidth="28dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/skip_next"
                    android:tint="@color/widget_preview_content" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_repeat"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:maxWidth="28dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/repeat"
                    android:tint="@color/widget_preview_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
