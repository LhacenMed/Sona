<?xml version="1.0" encoding="utf-8"?>
<!--
    The "Now Playing" widget: the cover on the left; the title and artist over the timeline and the controls
    on the right, the heart beside the title. Every colour is set as it is drawn, from the app's theme - the
    drawables are white so a tint can take them to any colour. The colours given here are the design's own, for
    the widget picker's preview, which shows the layout as it is written.

    Everything lines up on the content's edges - see widget_padding: the cover, the text, the timeline, and the
    outer controls' glyphs, whose buttons reach past the edge by widget_button_overhang. The controls are spread
    with equal room between them, the play button at the middle.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/widget_padding">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_cover_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/widget_cover_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_title"
                        android:text="@string/app_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_preview_content"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_artist"
                        android:text="@string/widget_preview_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_preview_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_favorite"
                    android:layout_width="@dimen/widget_button_size"
                    android:layout_height="@dimen/widget_button_size"
                    android:layout_marginTop="@dimen/widget_button_overhang"
                    android:layout_marginEnd="@dimen/widget_button_overhang"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="center"
                    android:src="@drawable/favorite_border"
                    android:tint="@color/widget_preview_content" />
            </LinearLayout>

            <!-- Whatever height is left goes between the titles and the timeline, as in the design. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- A timeline reads left to right in every language, as the player's own does. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_timeline_height"
                android:layoutDirection="ltr">

                <ImageView
                    android:id="@+id/widget_progress_track"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_progress_track"
                    android:tint="@color/widget_preview_track" />

                <ImageView
                    android:id="@+id/widget_progress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:paddingEnd="@dimen/widget_timeline_thumb_size"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_progress"
                    android:tint="@color/widget_preview_content" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_elapsed"
                    android:text="@string/widget_preview_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_preview_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_duration"
                    android:text="@string/widget_preview_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_preview_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_play_button_size"
                android:layout_marginStart="@dimen/widget_button_overhang"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="@dimen/widget_button_overhang"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_shuffle"
                    android:layout_width="@dimen/widget_button_size"
                    android:layout_height="@dimen/widget_button_size"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="center"
                    android:src="@drawable/shuffle"
                    android:tint="@color/widget_preview_content" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_previous"
                    android:layout_width="@dimen/widget_button_size"
                    android:layout_height="@dimen/widget_button_size"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_previous"
                    android:scaleType="center"
                    android:src="@drawable/skip_previous"
                    android:tint="@color/widget_preview_content" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/widget_play_pause"
                    android:layout_width="@dimen/widget_play_button_size"
                    android:layout_height="@dimen/widget_play_button_size">

                    <ImageView
                        android:id="@+id/widget_play_pause_circle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_play_circle"
                        android:tint="@color/widget_preview_content" />

                    <ImageView
                        android:id="@+id/widget_play_pause_icon"
                        android:tint="@color/brand_gradient_end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/play" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="@dimen/widget_button_size"
                    android:layout_height="@dimen/widget_button_size"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_next"
                    android:scaleType="center"
                    android:src="@drawable/skip_next"
                    android:tint="@color/widget_preview_content" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_repeat"
                    android:layout_width="@dimen/widget_button_size"
                    android:layout_height="@dimen/widget_button_size"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="center"
                    android:src="@drawable/repeat"
                    android:tint="@color/widget_preview_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
