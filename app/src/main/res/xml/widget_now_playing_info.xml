<?xml version="1.0" encoding="utf-8"?>
<!--
    Four cells wide and two rows tall - the card the design draws. Four cells is the whole row of the common
    four-column grids: a minWidth worth more cells than a
    grid has leaves the widget out of the launcher's picker altogether. It can grow across a wider grid but not shrink
    below that, where the cover would leave the controls no room, nor grow taller, which would only grow the cover into
    that room.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_now_playing"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="250dp"
    android:previewLayout="@layout/widget_now_playing"
    android:resizeMode="horizontal"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
